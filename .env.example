# Required
DISCORD_TOKEN=
CLIENT_ID=

# Optional — set for guild-scoped commands (instant propagation, good for dev)
GUILD_ID=

# Optional — defaults shown
DB_PATH=./data/bot.db
UPLOADS_DIR=./data/uploads

# Set to true to block users from creating mailboxes in channels they can't post in.
# Set to false (default) to allow moderators to schedule posts to locked/announcement channels.
ENFORCE_CHANNEL_PERMISSIONS=false
